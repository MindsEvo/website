  "title": {
    "zh": "比较",
    "en": "Comparison"
  },
  "description": {
    "zh": "比较是一种基于共同维度，对两个或多个对象进行关系判断、差异识别、顺序定位或等同性确认的元思维操作。",
    "en": "Comparison is a meta-thinking operation that uses shared dimensions to judge relations, identify differences, locate order, or confirm equivalence among two or more objects."
  },
  "ageRange": {
    "min": 4,
    "max": 12,
    "noteZh": "覆盖 4-5 岁到小学毕业阶段。",
    "noteEn": "Covers ages 4-5 through primary school graduation."
  },
  "educationReference": {
    "scope": "global-k12-foundation",
    "policyZh": "以全球基础教育大纲和教材为知识背景，不增加额外知识负担，以知识内容承载思维训练。",
    "policyEn": "Uses global K-12 foundational curricula as background knowledge without adding extra knowledge burden; domain content is used as a carrier for thinking training."
  },
