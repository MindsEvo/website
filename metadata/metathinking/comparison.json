  "levelMap": [
    {
      "levelId": "L1",
      "ageHint": "4-5",
      "objectiveZh": "在单一感知维度上做直接比较（大/小、多/少、长/短）。",
      "objectiveEn": "Perform direct comparison on a single perceptual dimension.",
      "primaryTypes": ["quantity", "spatial_visual"],
      "status": "implemented",
      "implementedBy": ["learning-math-comparison"],
      "sourceLevels": ["L1"]
    },
    {
      "levelId": "L2",
      "ageHint": "5-6",
      "objectiveZh": "在 10 以内进行数量与图示对应比较。",
      "objectiveEn": "Compare quantities within 10 using symbol-visual correspondence.",
      "primaryTypes": ["quantity", "spatial_visual"],
      "status": "implemented",
      "implementedBy": ["learning-math-comparison", "learning-math-number-sense"],
      "sourceLevels": ["L2"]
    },
    {
      "levelId": "L3",
      "ageHint": "6-7",
      "objectiveZh": "在 20 以内进行直接比较与接近判断。",
      "objectiveEn": "Perform direct and proximity comparison within 20.",
      "primaryTypes": ["quantity", "temporal"],
      "status": "implemented",
      "implementedBy": ["learning-math-comparison", "learning-math-number-sense"],
      "sourceLevels": ["L3"]
    },
    {
      "levelId": "L4",
      "ageHint": "7-8",
      "objectiveZh": "引入双维比较（如数量+长度），进行基础排序。",
      "objectiveEn": "Introduce dual-dimension comparison and basic ranking.",
      "primaryTypes": ["quantity", "spatial_visual"],
      "status": "planned"
    },
    {
      "levelId": "L5",
      "ageHint": "8-9",
      "objectiveZh": "进行间接与链式比较（A>B, B>C 推导 A>C）。",
      "objectiveEn": "Perform indirect and chain comparison.",
      "primaryTypes": ["logic_strategy"],
      "status": "planned"
    },
    {
      "levelId": "L6",
      "ageHint": "9-10",
      "objectiveZh": "在多维标准下比较并说明取舍理由。",
      "objectiveEn": "Compare under multi-criteria and explain trade-offs.",
      "primaryTypes": ["logic_strategy", "information"],
      "status": "planned"
    },
    {
      "levelId": "L7",
      "ageHint": "10-11",
      "objectiveZh": "比较策略效率与条件充分性，形成可解释判断。",
      "objectiveEn": "Compare strategy efficiency and condition sufficiency with explanations.",
      "primaryTypes": ["logic_strategy", "information"],
      "status": "planned"
    },
    {
      "levelId": "L8",
      "ageHint": "11-12",
      "objectiveZh": "比较证据强弱与信息可信度，完成综合判断。",
      "objectiveEn": "Compare evidence strength and information reliability for integrated judgment.",
      "primaryTypes": ["information"],
      "status": "planned"
    }
  ],
